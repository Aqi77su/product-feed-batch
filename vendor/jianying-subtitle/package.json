{
  "name": "jianying-subtitle",
  "version": "0.2.3",
  "description": "CLI tool to transcribe audio/video using JianYing (CapCut) free ASR API",
  "type": "module",
  "bin": {
    "jianying-subtitle": "bin/jianying-subtitle.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./asr": {
      "types": "./dist/asr/jianying.d.ts",
      "default": "./dist/asr/jianying.js"
    },
    "./subtitle": {
      "types": "./dist/subtitle/index.d.ts",
      "default": "./dist/subtitle/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/cli/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "jianying",
    "capcut",
    "asr",
    "subtitle",
    "transcription",
    "speech-to-text",
    "cli",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xifan2333/jianying-subtitle.git"
  },
  "homepage": "https://github.com/xifan2333/jianying-subtitle#readme",
  "bugs": {
    "url": "https://github.com/xifan2333/jianying-subtitle/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist",
    "bin",
    "extensions",
    "src",
    "package.json"
  ]
}
